# ===========================================
# AbachaOnline Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# Server Configuration
# ===========================================
NODE_ENV=production
PORT=3000

# Frontend URL (for CORS in production)
FRONTEND_URL=https://abachaonline.vercel.app

# ===========================================
# Database Configuration (Railway provides this)
# ===========================================
# Railway auto-injects DATABASE_URL when you add PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/railway

# ===========================================
# JWT Configuration
# ===========================================
# Generate secure secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ===========================================
# SMS Provider - EasySendSMS (Sierra Leone)
# https://www.easysendsms.com
# ===========================================
EASYSENDSMS_API_KEY=your_easysendsms_api_key
SMS_SENDER_ID=AbachaOL

# ===========================================
# Email Provider - SendGrid (Free Tier)
# https://sendgrid.com
# ===========================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@abachaonline.com
SENDGRID_FROM_NAME=AbachaOnline

# ===========================================
# OSRM Routing Configuration
# ===========================================
# Use public demo server (free) or self-hosted
OSRM_URL=https://router.project-osrm.org

# ===========================================
# RASA Chatbot Configuration
# ===========================================
# Update after deploying RASA to Render
RASA_URL=https://rasa-abachaonline.onrender.com

# ===========================================
# Redis Configuration (Optional)
# ===========================================
# Railway provides REDIS_URL when you add Redis service
# Comment out if not using Redis
# REDIS_URL=redis://default:password@host:6379

# ===========================================
# Notes for Railway Deployment:
# ===========================================
# 1. DATABASE_URL is auto-injected by Railway PostgreSQL
# 2. Set NODE_ENV=production in Railway dashboard
# 3. Generate a secure JWT_SECRET (64+ chars)
# 4. Update FRONTEND_URL to your Vercel domain
# 5. Update RASA_URL after Render deployment
# ===========================================
